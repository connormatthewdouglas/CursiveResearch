#!/usr/bin/env bash
# CursiveResearch corpus guardrail — Guard 1: placeholder / elision text.
#
# Blocks LLM lazy-elision placeholders committed verbatim (the 2026-06-16
# incident: Chapter 15 replaced by "[full new content would go here but for
# brevity]"). Content-based, so it runs reliably in pre-commit.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass in a true emergency:  git commit -n

set -u
RED=$'\033[1;31m'; YEL=$'\033[1;33m'; NC=$'\033[0m'
fail=0

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACM)

# The threat is a file whose CONTENT IS a placeholder (the agent replaced real
# text with an elision), so anchor to line-start: a standalone placeholder
# line, optionally prefixed by markdown heading/list/quote markers and a stray
# backtick. This deliberately does NOT match prose that *quotes* the pattern
# mid-sentence (e.g. these hooks' own docs), which previously self-triggered.
# Leading non-alphanumerics only (whitespace, BOM, #, >, *, -, backtick, [):
# a standalone placeholder line matches; prose where the phrase sits after real
# words (e.g. "a one-line placeholder (`...`)") does not.
prefix='^[^A-Za-z0-9]*'
phrases='(full new content would go here|content would go here but for brevity|rest of (the )?(file|chapter|content|sections?|document) (unchanged|here|omitted|follows)|\.\.\.[[:space:]]*\(?(rest|remainder|continued)|insert (full|the) (content|chapter) here|<full[_ ]content|TODO:[[:space:]]*(write|full|fill)|content omitted for brevity|truncated for brevity)'
placeholder_re="${prefix}${phrases}"

for f in "${staged[@]}"; do
    [[ -f "$f" ]] || continue
    case "$f" in
        .githooks/*) continue ;;   # these files document the patterns by design
    esac
    case "$f" in
        *.md|*.markdown|*.txt|*.sql|*.sh|*.py|*.js)
            if matches=$(grep -nEi "$placeholder_re" "$f"); then
                echo "${RED}BLOCKED (placeholder text):${NC} $f"
                echo "$matches" | sed 's/^/    /'
                fail=1
            fi ;;
    esac
done

if [[ "$fail" == "1" ]]; then
    echo "${YEL}Corpus guardrail: the staged content contains lazy-elision placeholders."
    echo "Write the real content (or 'git commit -n' to bypass in a true emergency).${NC}"
    exit 1
fi
exit 0
